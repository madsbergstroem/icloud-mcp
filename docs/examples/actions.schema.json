{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/sendgate/actions.schema.json",
  "title": "Sendgate connector file, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "actions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "title",
        "badge",
        "approve_label",
        "tool",
        "arguments",
        "params_schema",
        "recipient_fields",
        "rows",
        "result",
        "allow_setting"
      ],
      "properties": {
        "action": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "badge": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "approve_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12
        },
        "tool": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "arguments": {
          "type": "object"
        },
        "params_schema": {
          "type": "object"
        },
        "text_field": {
          "type": "string"
        },
        "editable_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "recipient_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "string"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "describe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool",
            "arguments",
            "copy"
          ],
          "properties": {
            "tool": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "arguments": {
              "type": "object"
            },
            "copy": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
              }
            },
            "recheck": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sent",
            "failed"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
            },
            "sent": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "failed": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            }
          }
        },
        "allow_setting": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*_ALLOWLIST$"
        },
        "enabled": {
          "type": "boolean"
        },
        "timeout_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 120
        }
      }
    }
  }
}
